# Copy to `.env` (untracked, git-ignored) and fill in before running the MCP
# server or the agent locally. Loaded automatically by src/config.py
# (python-dotenv) and by docker compose.

# Google Gemini API key for the agent tools. Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me

# Gemini model the agent calls.
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: per-task token budget (0 = unlimited).
TASK_TOKEN_BUDGET=0

# Optional: where usage records are written.
USAGE_LOG_PATH=usage.jsonl
