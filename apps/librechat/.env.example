HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/librechat
MCP_SERVER_URL=http://mcp-server:8000/mcp

# Enable local email/password sign-up (off by default in LibreChat)
ALLOW_REGISTRATION=true

# Dev-only placeholder secrets. LibreChat refuses to start without these.
# For deployment, copy this file to `.env` (untracked, kept off the repo)
# and replace every value below with your own generated secret:
# https://www.librechat.ai/docs/configuration/dotenv#security-settings
JWT_SECRET=95768eda5117393525bfa566385c1a22f1c4f2042aa6ac2c543e2766303739af
JWT_REFRESH_SECRET=a2cf122c74bc8e460b500666d4549043e33edc713cd55c51057c4c409c4b22e4
CREDS_KEY=df4541ab6c005602e5d5f8aebad8ed720895bc4f7b4fef158480c454fe32776e
CREDS_IV=cffc5560284b08a99f31ce9f5036b7b1

# Session secret for the OpenID/SSO login flow (Dex). Required by LibreChat
# whenever ALLOW_SOCIAL_LOGIN is enabled. Generate your own, e.g.:
#   openssl rand -hex 32
OPENID_SESSION_SECRET=replace-me-with-a-generated-secret
