version: 1.3.13
cache: true

mcpSettings:
  allowedDomains:
    # Both the MCP connection itself and OIDCProxy's OAuth endpoints
    # (authorize/token/register/metadata) live on this public hostname.
    # LibreChat's OAuth client requires the connection URL to match the
    # resource declared in protected-resource metadata (RFC 9728 §3.3), so
    # this can't be the internal "mcp-server" service name/port.
    - "mcp.__DOMAIN__"

mcpServers:
  tatc:
    type: streamable-http
    url: https://mcp.__DOMAIN__/mcp
    requiresOAuth: true
    timeout: 600000
    initTimeout: 15000
    serverInstructions: true
    chatMenu: true
    startup: true

endpoints:
  custom:
    # Voyager chat models are grouped here instead of under the built-in
    # OpenAI label.
    # TATC AI offers a short list: the top ASU Voyager models on the
    # Artificial Analysis Intelligence Index that can call tools. The proxy
    # serves more; to offer one, add its ID here and a modelSpecs entry
    # below, in both this file and the other librechat file, then run the
    # tool-calling eval in apps/mcp-server/eval with --models to check it.
    # fetch stays off so only the listed models appear in the picker.
    - name: ASU Voyager
      apiKey: ${VOYAGER_API_KEY}
      baseURL: ${VOYAGER_BASE_URL}
      models:
        default:
          - glm-5-3
          - glm-5-3-flash
          - deepseek-v4-1-flash
          - mimo-v2-6-flash
          - qwen38-27b
        fetch: false
      titleConvo: true
      titleModel: qwen38-27b
      modelDisplayLabel: ASU Voyager
    # Only models verified for chat, streaming, and tool calls are listed;
    # the API also serves embedding, speech, image, and realtime models.
    - name: ASU CreateAI
      apiKey: ${CREATEAI_API_KEY}
      baseURL: ${CREATEAI_BASE_URL}
      models:
        default:
          - aws/nova2-lite
          - aws/nova-lite
          - aws/nova-micro
          - aws/nova-pro
          - aws/claude4_5_haiku
          - aws/claude4_sonnet
          - aws/claude4_5_sonnet
          - aws/claude5_sonnet
          - aws/claude4_1_opus
          - aws/claude4_5_opus
          - aws/claude4_6_opus
          - aws/claude4_7_opus
          - aws/claude4_8_opus
          - aws/claude5_opus
          - gcp-deepmind/geminiflash2_5
          - gcp-deepmind/geminiflash2_5-lite
          - gcp-deepmind/geminiflash3
          - gcp-deepmind/geminiflash3_1_lite
          - gcp-deepmind/geminipro3_1
          - gcp-deepmind/geminiflash3_5
          - gcp-deepmind/geminiflash3_7
          - asu-air/gemma4_31b_it
          - asu-air/llama4_maverick-17b
          - asu-air/llama4_scout-17b
          - asu-air/muse-glimmer-30b
          - aws/gpt-oss-20b
          - aws/gpt-oss-120b
          - openai/gpt4o_mini
          - openai/gpt4_1
          - openai/gpt4_1-mini
          - openai/o3
          - openai/gpt5
          - openai/gpt5_mini
          - openai/gpt5_nano
          - openai/gpt5_1
          - openai/gpt5_1_instant
          - openai/gpt5_1_thinking
          - openai/gpt5_2
          - openai/gpt5_2_pro
          - openai/gpt5_4_mini
          - openai/gpt5_4_nano
          - openai/gpt5_4_thinking
          - openai/gpt5_4_pro
          - openai/gpt5_5
          - openai/gpt5_5_thinking
          - openai/gpt5_5_pro
          - openai/gpt5_6_luna
          - openai/gpt5_6_sol
          - openai/gpt5_6_terra
          - openai/gpt6_astra
        fetch: false
      titleConvo: true
      titleModel: aws/claude4_5_haiku
      modelDisplayLabel: ASU CreateAI
    # OpenCode keys come from https://opencode.ai/console. This base URL uses a
    # Go subscription; a Console-credits key gets OpenCode's balance error.
    - name: OpenCode
      apiKey: user_provided
      baseURL: https://opencode.ai/inference/go/openai/v1
      models:
        default:
          - glm-5.3-flash
          - deepseek-v4.1-flash
          - kimi-k3
          - qwen3.8-flash
        fetch: false
      headers:
        # OpenCode asks for a stable session and Go rejects a missing one. The
        # body conversation ID keeps one session per chat; title requests have no
        # conversation ID, so the user ID keeps the header non-empty.
        x-opencode-session: "{{LIBRECHAT_USER_ID}}-{{LIBRECHAT_BODY_CONVERSATIONID}}"
      titleConvo: true
      titleModel: glm-5.3-flash
      modelDisplayLabel: OpenCode
    # People bring their own key in Settings > Account > Provider API Keys.
    # LibreChat stores it encrypted per user and only sends it to this endpoint.
    - name: OpenRouter
      apiKey: user_provided
      baseURL: https://openrouter.ai/api/v1
      models:
        default:
          - openai/gpt-6.1-sol
          - anthropic/claude-sonnet-5.5
          - google/gemini-3.5-flash
        fetch: false
      titleConvo: true
      titleModel: current_model
      modelDisplayLabel: OpenRouter
  # The API keys for these are user_provided, set in the compose files.
  openAI:
    titleConvo: true
    titleModel: current_model
  anthropic:
    titleConvo: true
    # LibreChat's title requests send thinking disabled, which Opus 5.5 and Sonnet 5.5 reject.
    titleModel: claude-haiku-5-5
  google:
    titleConvo: true
    titleModel: current_model

interface:
  customWelcome: 'Welcome to TATC AI - ask about satellites, orbits, and ground tracks.'
  modelSelect: false
  parameters: true
  presets: false
  defaultPinnedTools:
    - tatc

modelSpecs:
  prioritize: true
  enforce: false
  # Every ASU spec sets maxContextTokens. LibreChat falls back to 32,000 for model
  # IDs it does not recognize, which these dash-form IDs are, and keeps only 95% of
  # that, so the TATC tool definitions left no room for the user's message.
  # Voyager values come from that endpoint's /models context_window field.
  list:
    - name: glm-5-3
      label: GLM-5.3
      description: Z.ai GLM chat model via ASU Voyager.
      group: ASU Voyager
      iconURL: https://github.com/zai-org.png
      showIconInMenu: true
      showIconInHeader: true
      mcpServers:
        - tatc
      preset:
        endpoint: ASU Voyager
        model: glm-5-3
        maxContextTokens: 131072
    - name: glm-5-3-flash
      label: GLM-5.3-Flash
      description: Z.ai GLM chat model via ASU Voyager.
      group: ASU Voyager
      iconURL: https://github.com/zai-org.png
      showIconInMenu: true
      showIconInHeader: true
      mcpServers:
        - tatc
      preset:
        endpoint: ASU Voyager
        model: glm-5-3-flash
        maxContextTokens: 262144
    - name: deepseek-v4-1-flash
      label: DeepSeek V4.1 Flash
      description: DeepSeek chat model via ASU Voyager.
      group: ASU Voyager
      iconURL: https://github.com/deepseek-ai.png
      showIconInMenu: true
      showIconInHeader: true
      mcpServers:
        - tatc
      preset:
        endpoint: ASU Voyager
        model: deepseek-v4-1-flash
        maxContextTokens: 262144
    - name: mimo-v2-6-flash
      label: MiMo-V2.6-Flash
      description: Xiaomi MiMo chat model via ASU Voyager.
      group: ASU Voyager
      iconURL: https://github.com/XiaomiMiMo.png
      showIconInMenu: true
      showIconInHeader: true
      mcpServers:
        - tatc
      preset:
        endpoint: ASU Voyager
        model: mimo-v2-6-flash
        maxContextTokens: 524288
    - name: qwen38-27b
      label: Qwen 3.8 27B
      description: Alibaba Qwen chat model via ASU Voyager.
      group: ASU Voyager
      iconURL: /assets/qwen.svg
      showIconInMenu: true
      showIconInHeader: true
      default: true
      showOnLanding: true
      conversation_starters:
        - Find three satellites with Hubble in their name and show their NORAD IDs.
        - What are the current orbital elements for NORAD ID 25544?
        - Show the ISS ground track for the next 10 minutes at one-minute intervals.
        - How often can Terra see Phoenix, Arizona over the next 24 hours? Use a 110 degree field of regard from the NASA MODIS design page.
        - How often can Sentinel-2A and Sentinel-2B together see Phoenix, Arizona in daylight over the next 60 days?
      mcpServers:
        - tatc
      preset:
        endpoint: ASU Voyager
        model: qwen38-27b
        maxContextTokens: 262144
    # CreateAI does not publish a per-model window; 128,000 is the smallest
    # context among the listed models, so every value is safe.
    - name: createai-nova2-lite
      label: Nova 2 Lite
      description: Amazon Nova chat model via ASU CreateAI.
      group: ASU CreateAI
      iconURL: https://github.com/aws.png
      showIconInMenu: true
      showIconInHeader: true
      mcpServers:
        - tatc
      preset:
        endpoint: ASU CreateAI
        model: aws/nova2-lite
        maxContextTokens: 128000
