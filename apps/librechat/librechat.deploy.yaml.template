version: 1.3.13
cache: true

mcpSettings:
  allowedDomains:
    # Both the MCP connection itself and OIDCProxy's OAuth endpoints
    # (authorize/token/register/metadata) live on this public hostname.
    # LibreChat's OAuth client requires the connection URL to match the
    # resource declared in protected-resource metadata (RFC 9728 §3.3), so
    # this can't be the internal "mcp-server" service name/port.
    - "mcp.__DOMAIN__"

mcpServers:
  tatc:
    type: streamable-http
    url: https://mcp.__DOMAIN__/mcp
    requiresOAuth: true
    timeout: 30000
    initTimeout: 15000
    serverInstructions: true
    chatMenu: true
    startup: true

endpoints:
  custom:
    # fetch stays off so embedding, transcription, image, and video models
    # never show in the picker; add new chat model IDs here when the proxy
    # gains them.
    - name: ASU Voyager
      apiKey: ${VOYAGER_API_KEY}
      baseURL: ${VOYAGER_BASE_URL}
      models:
        default:
          - olmo3-32b-instruct
          - olmo3-32b-think
          - olmo3-7b-instruct
          - olmo3-7b-think
          - qwen-agentworld-35b-a3b
          - qwen3-235b-a22b-instruct-2507
          - qwen3-235b-a22b-thinking-2507
          - qwen3-30b-a3b-instruct-2507
          - qwen3-30b-a3b-thinking-2507
          - qwen3-coder-30b-a3b-instruct
          - qwen3-coder-next
          - qwen3-vl-32b-instruct
          - qwen3-vl-32b-thinking
          - qwen35-122b-a10b
          - qwen35-27b
          - qwen35-35b-a3b
          - qwen36-27b
          - qwen36-35b-a3b
          - qwen38-27b
          - north-mini-code
          - gemma4-31b-it
          - granite41-30b
          - llama3-groq-70b-tool-use
          - llama4-maverick-17b
          - llama4-scout-17b
          - muse-glimmer-30b
          - minimax-m2-7
          - minimax-m3
          - devstral2-123b
          - kimi-k2-7-code
          - gpt-oss-120b
          - ornith-1-0-35b
          - ornith-1-5-35b-a3b
          - laguna-s-2-1
          - inkling-small
          - glm-4-5v
          - glm-5-2
          - glm-5-3
          - glm-5-3-flash
        fetch: false
      titleConvo: true
      titleModel: llama4-scout-17b
      modelDisplayLabel: ASU Voyager
    # Only models verified for chat, streaming, and tool calls are listed;
    # the API also serves embedding, speech, image, and realtime models.
    - name: ASU CreateAI
      apiKey: ${CREATEAI_API_KEY}
      baseURL: ${CREATEAI_BASE_URL}
      models:
        default:
          - aws/nova2-lite
          - aws/nova-lite
          - aws/nova-micro
          - aws/nova-pro
          - aws/claude4_5_haiku
          - aws/claude4_sonnet
          - aws/claude4_5_sonnet
          - aws/claude5_sonnet
          - aws/claude4_1_opus
