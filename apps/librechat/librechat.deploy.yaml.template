version: 1.3.13
cache: true

mcpSettings:
  allowedDomains:
    # Both the MCP connection itself and OIDCProxy's OAuth endpoints
    # (authorize/token/register/metadata) live on this public hostname.
    # LibreChat's OAuth client requires the connection URL to match the
    # resource declared in protected-resource metadata (RFC 9728 §3.3), so
    # this can't be the internal "mcp-server" service name/port.
    - "mcp.__DOMAIN__"

mcpServers:
  mcp-server:
    type: streamable-http
    url: https://mcp.__DOMAIN__/mcp
    requiresOAuth: true
    timeout: 30000
    initTimeout: 15000
    serverInstructions: true
    chatMenu: true
    startup: true
