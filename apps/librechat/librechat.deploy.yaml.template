version: 1.3.13
cache: true

mcpSettings:
  allowedDomains:
    # Both the MCP connection itself and OIDCProxy's OAuth endpoints
    # (authorize/token/register/metadata) live on this public hostname.
    # LibreChat's OAuth client requires the connection URL to match the
    # resource declared in protected-resource metadata (RFC 9728 §3.3), so
    # this can't be the internal "mcp-server" service name/port.
    - "mcp.__DOMAIN__"

mcpServers:
  tatc:
    type: streamable-http
    url: https://mcp.__DOMAIN__/mcp
    requiresOAuth: true
    timeout: 30000
    initTimeout: 15000
    serverInstructions: true
    chatMenu: true
    startup: true

endpoints:
  custom:
    # All chat models come from ASU Voyager for now, so they are grouped
    # here instead of under the built-in OpenAI label. The key and proxy URL
    # reuse the existing OPENAI_* env vars, so no new secrets are needed.
    # fetch stays off so embedding, transcription, image, and video models
    # never show in the picker; add new chat model IDs here when the proxy
    # gains them. Add another custom endpoint later when models come from
    # other sources.
    - name: ASU Voyager
      apiKey: ${OPENAI_API_KEY}
      baseURL: ${OPENAI_REVERSE_PROXY}
      models:
        default:
          - llama4-scout-17b
          - llama4-maverick-17b
          - llama3-groq-70b-tool-use
          - qwen3-coder-30b-a3b-instruct
          - qwen3-coder-next
          - qwen3-30b-a3b-thinking-2507
          - qwen3-30b-a3b-instruct-2507
          - qwen3-235b-a22b-instruct-2507
          - qwen3-235b-a22b-thinking-2507
          - qwen3-vl-32b-instruct
          - qwen3-vl-32b-thinking
          - qwen35-27b
          - qwen35-122b-a10b
          - qwen36-27b
          - qwen38-27b
          - qwen35-35b-a3b
          - qwen36-35b-a3b
          - qwen-agentworld-35b-a3b
          - gemma3-27b-it
          - gemma4-31b-it
          - gpt-oss-120b
          - devstral2-123b
          - minimax-m2-7
          - minimax-m3
          - kimi-k2-7-code
          - glm-4-5v
          - glm-5-2
          - glm-5-3
          - glm-5-3-flash
          - olmo3-7b-instruct
          - olmo3-7b-think
          - olmo3-32b-think
          - olmo3-32b-instruct
          - granite41-30b
          - muse-glimmer-30b
          - north-mini-code
          - inkling-small
          - laguna-s-2-1
          - ornith-1-0-35b
        fetch: false
      titleConvo: true
      titleModel: llama4-scout-17b
      modelDisplayLabel: ASU Voyager

interface:
  customWelcome: 'Welcome to TATC AI - ask about satellites, orbits, and ground tracks.'
  modelSelect: false
  parameters: true
  presets: false
  defaultPinnedTools:
    - tatc

modelSpecs:
  prioritize: true
  enforce: false
  list:
    - name: tatc-scout
      label: Llama 4 Scout 17B
      description: ASU-hosted chat model for TATC AI satellite workflows.
      group: ASU Voyager
      iconURL: https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/meta.svg
      showIconInMenu: true
      showIconInHeader: true
      default: true
      showOnLanding: true
      conversation_starters:
        - Use the satellite search tool to find three satellites with Hubble in their name. Show their names and NORAD IDs.
        - Use the satellite info tool to get details for NORAD ID 25544, including its current TLE.
        - Generate a ground track for NORAD ID 25544 starting now, lasting 10 minutes, with one-minute intervals.
      mcpServers:
        - tatc
      preset:
        endpoint: ASU Voyager
        model: llama4-scout-17b
    - name: llama4-maverick-17b
      label: Llama 4 Maverick 17B
      description: Meta Llama chat model via ASU Voyager.
      group: ASU Voyager
