# Copy to `.env` (untracked) and fill in real values before running
# docker compose -f docker-compose.deploy.yml up -d
# docker compose automatically loads `.env` from this directory.

# Public domain the deployment is served under. Traefik routes:
#   https://chat.<DOMAIN>  -> LibreChat
#   https://mcp.<DOMAIN>   -> MCP server
#   https://auth.<DOMAIN>  -> Dex
DOMAIN=ai.tatc.code-lab.org

# Email Let's Encrypt uses for expiry/revocation notices.
ACME_EMAIL=replace-me@example.com

# Dex OIDC provider secrets. Generate real values, do not reuse examples.
DEX_DEV_PASSWORD_HASH=replace-me-with-bcrypt-hash
DEX_LIBRECHAT_CLIENT_SECRET=replace-me
DEX_MCP_CLIENT_SECRET=replace-me

# Which built MCP server image to deploy. The build-mcp-server workflow
# pushes both `latest` and a tag matching the git commit SHA it built from.
# Leave this on `latest` so auto-deploy (.github/workflows/deploy.yml) picks
# up new images automatically, or pin it to a specific SHA for a
# reproducible, rollback-able deploy that auto-deploy won't move off of.
MCP_SERVER_IMAGE_TAG=latest
